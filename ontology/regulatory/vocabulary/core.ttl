@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://ontology.metareasoning.ai/core#Concept> a skos:Concept ;
    skos:broader <https://ontology.metareasoning.ai/regulatory/vocabulary/core> ;
    skos:definition "A named idea used across products (e.g. AUM, drift index)."@en ;
    skos:inScheme <https://ontology.metareasoning.ai/regulatory/vocabulary/core/scheme> ;
    skos:prefLabel "Concept"@en .

<https://ontology.metareasoning.ai/core#Entity> a skos:Concept ;
    skos:broader <https://ontology.metareasoning.ai/regulatory/vocabulary/core> ;
    skos:definition "Anything that can be referenced in verification or agent reasoning."@en ;
    skos:inScheme <https://ontology.metareasoning.ai/regulatory/vocabulary/core/scheme> ;
    skos:prefLabel "Entity"@en .

<https://ontology.metareasoning.ai/core#VerifierCheck> a skos:Concept ;
    skos:broader <https://ontology.metareasoning.ai/regulatory/vocabulary/core> ;
    skos:definition "A deterministic check type executed by the verification engine."@en ;
    skos:inScheme <https://ontology.metareasoning.ai/regulatory/vocabulary/core/scheme> ;
    skos:prefLabel "Verifier check"@en .

<https://ontology.metareasoning.ai/regulatory/vocabulary/core> a skos:Concept ;
    skos:inScheme <https://ontology.metareasoning.ai/regulatory/vocabulary/core/scheme> ;
    skos:narrower <https://ontology.metareasoning.ai/core#Concept>,
        <https://ontology.metareasoning.ai/core#Entity>,
        <https://ontology.metareasoning.ai/core#VerifierCheck> ;
    skos:prefLabel "Core"@en ;
    skos:topConceptOf <https://ontology.metareasoning.ai/regulatory/vocabulary/core/scheme> .

<https://ontology.metareasoning.ai/regulatory/vocabulary/core/scheme> a skos:ConceptScheme ;
    dcterms:description "SKOS view of the Core ontology classes."@en ;
    skos:hasTopConcept <https://ontology.metareasoning.ai/regulatory/vocabulary/core> ;
    skos:prefLabel "Core Vocabulary"@en .

