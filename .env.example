# Postgres for regulatory corpus (same tables as multicatalyst-agents).
POSTGRES_USER=ontology
POSTGRES_PASSWORD=ontology_dev_password
POSTGRES_DB=ontology
POSTGRES_HOST_PORT=5436

# Used by scripts/bootstrap_postgres.sh and local tooling.
# Homebrew Postgres (default port 5432):
DATABASE_URL=postgresql://ontology:ontology_dev_password@127.0.0.1:5432/ontology
# Docker compose (host port POSTGRES_HOST_PORT):
# DATABASE_URL=postgresql://ontology:ontology_dev_password@127.0.0.1:5436/ontology

# Optional source for ./scripts/bootstrap_postgres.sh --sync-from-multicatalyst
MULTICATALYST_DATABASE_URL=postgresql://mc:mc_dev_password@127.0.0.1:5432/multicatalyst

# Optional LLM upgrade for serious ontology generation (triplets + TBox refine).
# Without a key, generation still runs seriously via spaCy ML + regulatory patterns.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# SEMANTICA_LLM_PROVIDER=anthropic
# SEMANTICA_LLM_MODEL=claude-sonnet-4-20250514

# Local Semantica Explorer
SEMANTICA_ALLOW_ANONYMOUS=true
